# Runtime caches and generated state (regenerable)
/storage/cache/
/storage/ai_os/
/storage/logs/
/storage/render_jobs/
/storage/social_uploads/
/storage/agent_state/
/storage/projects/
/storage/security/

# Model training artifacts: large, regenerated hourly
/storage/model_training/snapshots/
/storage/model_training/artifacts/
/storage/model_training/*.jsonl
/storage/hf_datasets/

# Python
__pycache__/
*.py[cod]
.venv/
.venv-*/
*.egg-info/

# Local env / editor / OS
.env
.env.*
!.env.example
.vscode/
*.bak
*.bak-*
*.orig
.DS_Store

# ── Build artifacts and dependency trees ──
# Regenerable from source. Committing them bloats history and exceeds GitHub's
# per-file limit (node_modules/electron alone is 144 MB, over the 100 MB cap).
node_modules/
dist/
desktop/*/dist/
desktop/*/node_modules/

# ── Release installers ──
# Served to users by desktop-updates/download.php from the filesystem.
# They do not belong in version control.
desktop-updates/

# ── Runtime state ──
# Written continuously by the application; not source.
storage/
api/lib/storage/

# Nested virtualenv used by the render worker scripts
scripts/render_worker/.venv/
.venv/
