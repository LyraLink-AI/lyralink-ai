LYRALINK_SERVER_URL=https://lyralinkai.com
RENDER_WORKER_SHARED_KEY=
RENDER_WORKER_NAME=gtx1660-main
RENDER_WORKER_POLL_INTERVAL=8
RENDER_WORKER_REQUEST_TIMEOUT=180

# Local GPU image generation API (Stable Diffusion WebUI / Forge API mode)
SD_WEBUI_URL=http://127.0.0.1:7860
SD_STEPS=30
SD_CFG=7.0
SD_SAMPLER=DPM++ 2M Karras
SD_WIDTH=1024
SD_HEIGHT=576
SD_NEGATIVE_PROMPT=blurry, low quality, artifact, jpeg artifacts, distorted face, watermark, text, logo, oversaturated

# Free neural narration voice from Microsoft Edge TTS
EDGE_TTS_VOICE=en-US-JennyNeural

# Timed captions
ENABLE_CAPTIONS=1

# Background music ducking
ENABLE_BACKGROUND_MUSIC=1
BACKGROUND_MUSIC_DIR=
BACKGROUND_MUSIC_MOOD=tech_cinematic
BACKGROUND_MUSIC_VOLUME=0.18
REMOTE_MUSIC_PROVIDER=internet_archive
REMOTE_MUSIC_CACHE_DIR=
REMOTE_MUSIC_QUERY=

# Optional motion-model stage
MOTION_PROVIDER=auto
MOTION_API_URL=
MOTION_STRENGTH=0.58
