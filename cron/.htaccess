# --- LYRALINK DEFAULT-DENY ---------------------------------------------------
# Consumed by the application via the filesystem and by cron, never over HTTP.
# This is a default-deny rather than an extension blocklist because a blocklist
# silently misses every extension nobody thought of: the site-level rule covers
# jsonl/py/sh/md/log/sql but not .json, so eval_gate/baseline.json and
# train_export.report.json were being served publicly.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>
Options -Indexes
# -----------------------------------------------------------------------------
