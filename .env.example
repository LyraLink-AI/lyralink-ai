# OpenSERP (self-hosted browser-rendered SERP API, github.com/karust/openserp)
# Primary search source. bing is deliberately absent from OPENSRP_ENGINES:
# measured returning unrelated results ('Capital : Actualites Economie' for
# a query about the capital of France). ecosia returns HTTP 403.
OPENSRP_BASE_URL=http://127.0.0.1:7000
OPENSRP_ENGINES=google,duckduckgo
# OpenSERP parses only the first SERP page when limit is omitted or <=10.
# 20 reads two pages; hard maximum is 100.
OPENSRP_LIMIT=20
# Top N results (0-5) to return with page content embedded. Embedded content
# counts as a verified retrieval, so this is what lets the runtime cite sources.
OPENSRP_EXTRACT=2
OPENSRP_TIMEOUT=12
# Search+fetch budget in ms. Must exceed OPENSRP_TIMEOUT*something, because
# overrunning it marks the search timed_out and forces result_verified false.
CHAT_WEB_SEARCH_BUDGET_MS=16000

# Automatic context compaction. Folds older conversation turns into a small
# deterministic digest instead of letting trimMessages() discard them, so a long
# chat keeps its earlier context while the prompt (and prefill latency) stays
# small. Deterministic by design: an LLM summary would need a model call every
# turn, since history arrives from the client and is not cached server-side.
CHAT_CONTEXT_COMPACT=1
# Recent turns kept verbatim. Keep this well under trimMessages()' 12-message
# budget, or the digest at the front of the array gets trimmed away first.
CHAT_CONTEXT_COMPACT_KEEP_RECENT=8
CHAT_CONTEXT_COMPACT_DIGEST_CHARS=3000
CHAT_CONTEXT_COMPACT_USER_CHARS=220
CHAT_CONTEXT_COMPACT_ASST_CHARS=160

# Interactive reply-token caps. On CPU-only inference (no GPU) generation runs at
# roughly 8-15 tokens/second, so these values ARE the latency budget:
#   cap 384 -> ~26-48s      cap 256 -> ~17-32s      cap 192 -> ~13-24s
# Ordinary turns are capped at CHAT_REPLY_TOKEN_INTERACTIVE. A turn is escalated to
# CHAT_REPLY_TOKEN_DETAIL only when the user explicitly asks for depth ("detailed",
# "step by step", "comprehensive"), not merely because the message is long.
CHAT_REPLY_TOKEN_INTERACTIVE=384
CHAT_REPLY_TOKEN_DETAIL=768
# Lower bound for CHAT_MAX_REPLY_TOKENS. Previously hardcoded to 512, which made
# lowering CHAT_MAX_REPLY_TOKENS below 512 silently ineffective.
CHAT_MAX_REPLY_TOKENS_MIN=256

# --- Adaptive local inference timeout (Recommendation 1) -------------------
# Sizes the local LLM timeout to the actual prompt instead of a fixed 18s
# floor. Default 0 keeps the historical fixed behaviour.
#   Measured on this box: TTFT ~10.6 ms per prompt token, so a 2200-token
#   prompt needs ~23s before the first token. Any deadline below that
#   guarantees an abort followed by a history-dropping retry.
LLM_ADAPTIVE_TIMEOUT=0
LLM_PREFILL_TOK_S=80
LLM_GEN_TOK_S=29
LLM_ADAPTIVE_OVERHEAD_SECONDS=6
LLM_ADAPTIVE_MAX_SECONDS=120
# Raises the hard-coded 25s ceiling on the fast-path deadline. Without this
# the adaptive floor cannot take effect on the streaming fast path.
CHAT_STREAM_FAST_DEADLINE_MAX=25

# ═══ Launch list / email capture (added 2026-09-23) ═══════════════════════
# Consumed by api/subscribe.php, which backs the public form on the landing
# page. The real list lives in the admin_ database, table marketing_subscribers.
#
# Subscriber IPs are stored ONLY as a salted HMAC, never raw. An unsalted hash
# of an IPv4 address is trivially reversible (the whole space is 2^32), so this
# salt is what makes the hashing meaningful rather than decorative.
# Rotating it is safe and only affects rows written afterwards. (generate one with: openssl rand -hex 32)
SUBSCRIBE_IP_SALT=
# Max subscribe attempts per IP per hour (valid range 1-100; anything outside
# that falls back to 5).
SUBSCRIBE_RATE_LIMIT_PER_HOUR=5
# Optional: address to notify on each new signup. Blank disables notification.
SUBSCRIBE_NOTIFY_EMAIL=

# ═══ Launch channels - placeholders, fill in when the accounts exist ══════
# These are for MANUAL launch activity and READ-ONLY research only.
#
# DO NOT set MARKETING_ALLOW_REDDIT_POSTS=1 or MARKETING_ALLOW_PUBLIC_POSTS=1.
# Automated posting gets the DOMAIN banned on Reddit, not just the account, and
# that ban is effectively permanent - it would remove the best-matched channel
# permanently. Hacker News and Reddit participation must be human and disclosed.
# The marketing autopilot should stay a research/drafting tool: its cron already
# collects opportunities and experiments usefully with publishing blocked.
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=
MASTODON_INSTANCE=
MASTODON_ACCESS_TOKEN=
