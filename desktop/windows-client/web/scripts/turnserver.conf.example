listening-port=3478
tls-listening-port=5349
fingerprint
use-auth-secret=no
lt-cred-mech
realm=__TURN_REALM__
server-name=__TURN_DOMAIN__
user=__TURN_USER__:__TURN_PASS__
listening-ip=0.0.0.0
external-ip=__TURN_EXTERNAL_IP__
min-port=49152
max-port=65535
no-cli
no-multicast-peers
stale-nonce
log-file=/var/log/turnserver/turnserver.log
simple-log
no-loopback-peers
no-tlsv1
no-tlsv1_1
cipher-list=DEFAULT
