# Apple signing environment variables for Tauri macOS builds.
# Set these before running `npm run build:mac:signed`.
#
# For details, see SIGNING.md

# Base64-encoded signing certificate (.p12)
# Generate with: base64 -i /path/to/cert.p12
APPLE_CERTIFICATE=""

# Password for the P12 certificate
APPLE_CERTIFICATE_PASSWORD=

# Signing identity (from `security find-identity -v`)
# Format: Developer ID Application: Name (TEAMID)
APPLE_SIGNING_IDENTITY=""

# Apple Team ID
APPLE_TEAM_ID=""
