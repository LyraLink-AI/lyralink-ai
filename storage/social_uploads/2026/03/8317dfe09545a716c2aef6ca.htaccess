# LEDESMA'S MOTORS — Admin Panel .htaccess
Options -Indexes
DirectoryIndex login.php

# Protect config file specifically
<Files "config.php">
  Order Allow,Deny
  Deny from all
</Files>

# Security headers
<IfModule mod_headers.c>
  Header always set X-Frame-Options "DENY"
  Header always set X-Content-Type-Options "nosniff"
</IfModule>